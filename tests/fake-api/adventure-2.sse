data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "{\"title\": \"The Silver Acorn\", \"world\": \"Middle-earth, the Shire\", \"intro\": \"The Shire, in the green heart of Middle-earth, where hobbits mind their gardens and nothing much ever happens. You are Pip T"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "unnelly, a young hobbit of Bywater who reads the weather better than books. This morning, something has happened.\", \"character\": {\"name\": \"Pip Tunnelly\", \"background\": \"A young hobbit of Bywater who r"}}

event: content_block_delta
data: {"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": "eads the weather better than books, and talks his way out of most trouble.\", \"st\": 8, \"dx\": 12, \"iq\": 11, \"ht\": 12, \"skills\": [{\"skill\": \"stealth\", \"level\": 14}, {\"skill\": \"knife\", \"level\": 14}, {\"ski"}}

